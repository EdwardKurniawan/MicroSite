<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{seo.title}}</title>
  <meta name="description" content="{{seo.description}}" />
  <link rel="canonical" href="{{seo.canonical}}" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="{{seo.og.title}}" />
  <meta property="og:description" content="{{seo.og.description}}" />
  <meta property="og:image" content="{{seo.og.image}}" />
  <meta property="og:url" content="{{seo.canonical}}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{seo.twitter.title}}" />
  <meta name="twitter:description" content="{{seo.twitter.description}}" />
  <meta name="twitter:image" content="{{seo.twitter.image}}" />
  <script type="application/ld+json">{{{json seo.schema}}}</script>

  <link rel="stylesheet" href="/shared/index.css" />
  <link rel="stylesheet" href="/shared/global-nav.css" />
  <script src="/shared/global-nav.js" defer></script>

  <style>
    :root {
      --theme-accent: {{theme.accent}};
      --theme-accent-dark: {{theme.accentDark}};
      --theme-accent-light: {{theme.accentLight}};
    }
  </style>
  <script>
    window.CITY_NAME = "{{city_name}}";
    window.CITY_SLUG = "{{city_slug}}";
    window.PAGE_CONTEXT = { navigation: {{{json navigation}}} };
  </script>
</head>
<body>
  <main class="page-shell">
    {{> venue-hero}}

    <section class="section-shell">
      <div class="shell editorial-layout">
        <div class="editorial-stack">
          <article class="editorial-panel">
            {{> section-heading eyebrow="Why It Matters" title=hero.title description=venue.lead}}
            <div class="copy-block" style="margin-top:1.2rem;">{{{venue.body_html}}}</div>
          </article>

          {{#if venue.context.planning_tips.length}}
            <article class="editorial-panel">
              {{> section-heading eyebrow="How To Use It" title="Make these planning calls first"}}
              <div class="editorial-stack venue-planning-stack">
                {{#each venue.context.planning_tips}}
                  <div class="venue-planning-card">
                    <h3 class="sidebar-title">{{title}}</h3>
                    <p>{{body}}</p>
                  </div>
                {{/each}}
              </div>
            </article>
          {{/if}}

          {{#if venue.booking_url}}
            <article class="editorial-panel">
              <span class="section-eyebrow">Booking</span>
              <h2 class="sidebar-title">Reserve this stop before you lock the day</h2>
              <p class="footer-copy">{{venue.context.booking_note}}</p>
              <div class="editorial-actions">
                <a href="{{venue.booking_url}}" class="button-link">{{#if venue.booking_label}}{{venue.booking_label}}{{else}}Check Availability{{/if}}</a>
                <a href="{{navigation.home_url}}#collections" class="button-link button-link-secondary">Compare More Options</a>
              </div>
            </article>
          {{/if}}

          {{#if venue.context.supporting_guides.length}}
            <article class="editorial-panel">
              {{> section-heading eyebrow="Keep Planning" title="Open the guides around this stop"}}
              <div class="story-grid venue-support-grid">
                {{#each venue.context.supporting_guides}}
                  <a href="{{url}}" class="story-card story-card-support">
                    <div class="story-body">
                      <h3>{{title}}</h3>
                      <p>{{description}}</p>
                      <span class="story-link">Open guide</span>
                    </div>
                  </a>
                {{/each}}
              </div>
            </article>
          {{/if}}
        </div>

        <aside class="editorial-stack">
          <article class="toolkit-card">
            <h3>Visit Snapshot</h3>
            {{#if venue.context.snapshot.length}}
              <div class="transport-list">
                {{#each venue.context.snapshot}}
                  <div class="transport-item"><strong>{{label}}</strong>: {{value}}</div>
                {{/each}}
                {{#if venue.opening_hours}}<div class="transport-item"><strong>Opening hours</strong>: {{venue.opening_hours}}</div>{{/if}}
                {{#if venue.address}}<div class="transport-item"><strong>Address</strong>: {{venue.address}}</div>{{/if}}
              </div>
            {{else}}
              <div class="transport-list">
                {{#if venue.category}}<div class="transport-item"><strong>Category</strong>: {{venue.category}}</div>{{/if}}
                {{#if venue.duration}}<div class="transport-item"><strong>Duration</strong>: {{venue.duration}}</div>{{/if}}
                {{#if venue.opening_hours}}<div class="transport-item"><strong>Opening hours</strong>: {{venue.opening_hours}}</div>{{/if}}
                {{#if venue.address}}<div class="transport-item"><strong>Address</strong>: {{venue.address}}</div>{{/if}}
              </div>
            {{/if}}
          </article>

          <article class="toolkit-card">
            <h3>Local Angle</h3>
            <p>{{venue.context.local_angle}}</p>
            {{#if venue.rating}}<div class="editorial-note"><strong>Rating</strong> {{venue.rating}} / 5 from {{venue.reviews}} reviews.</div>{{/if}}
          </article>

          <article class="toolkit-card byline-card">
            <span class="editorial-kicker">Editor</span>
            <h3>{{author.name}}</h3>
            <p>{{author.bio}}</p>
            <a href="{{author.url}}" class="story-link">Meet the editor</a>
          </article>
        </aside>
      </div>
    </section>

    {{> cta-band cta_band}}
  </main>

  {{> footer}}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      els.forEach(function (el) { io.observe(el); });
    });
  </script>
</body>
</html>
