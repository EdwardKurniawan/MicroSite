<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{seo.title}}</title>
  <meta name="description" content="{{seo.description}}" />
  <link rel="canonical" href="{{seo.canonical}}" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{seo.og.title}}" />
  <meta property="og:description" content="{{seo.og.description}}" />
  <meta property="og:image" content="{{seo.og.image}}" />
  <meta property="og:url" content="{{seo.canonical}}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{seo.twitter.title}}" />
  <meta name="twitter:description" content="{{seo.twitter.description}}" />
  <meta name="twitter:image" content="{{seo.twitter.image}}" />
  <script type="application/ld+json">{{{json seo.schema}}}</script>

  <link rel="stylesheet" href="/shared/index.css" />
  <link rel="stylesheet" href="/shared/global-nav.css" />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <script src="/shared/global-nav.js" defer></script>
  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
    defer
  ></script>
  <script src="/shared/neighbourhood-map.js" defer></script>

  <style>
    :root {
      --theme-accent: {{theme.accent}};
      --theme-accent-dark: {{theme.accentDark}};
      --theme-accent-light: {{theme.accentLight}};
    }
  </style>
  <script>
    window.CITY_NAME = "{{city_name}}";
    window.CITY_SLUG = "{{city_slug}}";
    window.PAGE_CONTEXT = { navigation: {{{json navigation}}} };
  </script>
</head>
<body>
  <main class="page-shell">
    {{> guide-hero}}

    <section id="city-overview" class="section-shell guide-overview-section">
      <div class="shell insight-grid">
        <div>
          {{> section-heading eyebrow=intro.eyebrow title=intro.title description="Use this page to answer the big search-intent questions fast: what to do, what to see first, what is happening, and what deserves advance planning."}}
          <div class="copy-block copy-block-lede">{{{firstParagraph intro.body_html}}}</div>
          {{#if guide_pages.length}}
            <div class="homepage-link-cluster">
              {{#each guide_pages}}
                <a href="{{url}}" class="homepage-link-chip">{{title}}</a>
              {{/each}}
            </div>
          {{/if}}
        </div>
        <aside class="insight-aside">
          <h3 class="sidebar-title">Essential Briefing</h3>
          {{> fact-grid items=quick_info}}
        </aside>
      </div>
    </section>

    {{#if top_things.length}}
      <section id="top-things" class="section-shell guide-top-things-section">
        <div class="shell">
          {{> section-heading eyebrow="Best Things To Do" title="Start with the best things to do in the city" description="This is the short list for broad intent: what to do, what to see first, and which experiences should shape the first version of the itinerary."}}
          {{#if guide_pages.length}}
            <div class="section-utility-links">
              {{#each guide_pages}}
                {{#if (eq title "Best Things To Do")}}
                  <a href="{{url}}" class="story-link">Open the full ranked guide</a>
                {{/if}}
              {{/each}}
            </div>
          {{/if}}
          <div class="story-grid">
            {{#each top_things}}
              {{> top-thing-card}}
            {{/each}}
          </div>
        </div>
      </section>
    {{/if}}

    {{#if events.length}}
      <section id="events" class="section-shell section-shell-muted guide-events-section">
        <div class="shell">
          {{> section-heading eyebrow="What's Happening" title="Check what is happening before you lock the trip" description="Seasonal swings, festivals, and current city moments can change what deserves priority more than people expect."}}
          <div class="section-utility-links">
            <a href="/{{city_slug}}/events/" class="story-link">Open the events hub</a>
            <a href="/{{city_slug}}/events/this-month/" class="story-link">See this month</a>
            <a href="/{{city_slug}}/events/this-weekend/" class="story-link">See this weekend</a>
          </div>
          <div class="events-grid">
            {{#each events}}
              {{> event-card}}
            {{/each}}
          </div>
        </div>
      </section>
    {{/if}}

    <section id="collections" class="section-shell section-shell-muted guide-collections-section">
      <div class="shell">
        {{> section-heading eyebrow="Plan The Trip" title="Open the guide that matches how you want to do the city"}}
        <div class="section-utility-links">
          {{#each guide_pages}}
            {{#if (eq title "Where To Stay")}}
              <a href="{{url}}" class="story-link">Where to stay</a>
            {{/if}}
            {{#if (eq title "Best Restaurants")}}
              <a href="{{url}}" class="story-link">Best restaurants</a>
            {{/if}}
          {{/each}}
        </div>
        <div class="story-grid">
          {{#each categories}}
            {{> category-card}}
          {{/each}}
        </div>
      </div>
    </section>

    <section id="neighbourhoods" class="section-shell guide-neighbourhoods-section">
      <div class="shell">
        {{> section-heading eyebrow="Neighbourhoods" title="Pick the area that fits your pace and stay style"}}
        <div class="section-utility-links">
          {{#each guide_pages}}
            {{#if (eq title "Where To Stay")}}
              <a href="{{url}}" class="story-link">Open the stay guide</a>
            {{/if}}
          {{/each}}
        </div>
        {{#if neighbourhood_map.length}}
          {{> neighbourhood-map}}
        {{/if}}
        <div class="story-grid">
          {{#each neighbourhoods}}
            {{> district-card}}
          {{/each}}
        </div>
      </div>
    </section>

    {{#if faqs.length}}
      <section id="faqs" class="section-shell section-shell-muted">
        <div class="shell shell-narrow">
          {{> section-heading eyebrow="FAQs" title="Questions people ask before they book the trip"}}
          {{> faq-list items=faqs}}
        </div>
      </section>
    {{/if}}

    {{> cta-band cta_band}}
  </main>

  {{> footer}}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      els.forEach(function (el) { io.observe(el); });
    });
  </script>
</body>
</html>
