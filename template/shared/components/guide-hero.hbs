<section class="page-hero page-hero-guide" style="background-image:url('{{hero.image}}')">
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content shell">
    <span class="page-kicker">{{hero.eyebrow}}</span>
    <h1 class="page-title">{{hero.title}}</h1>
    {{#if hero.tagline}}<p class="page-subtitle">{{hero.tagline}}</p>{{/if}}
    {{#if hero_actions.length}}
      <div class="hero-actions-shell">
        <div class="hero-actions">
          {{#each hero_actions}}
            <a href="{{url}}" class="button-link {{#unless (eq style 'primary')}}button-link-secondary{{/unless}}">{{label}}</a>
          {{/each}}
        </div>
        <div class="hero-proof">
          <span>What to do</span>
          <span>What to see</span>
          <span>What&apos;s happening</span>
          <span>What to book first</span>
        </div>
      </div>
    {{/if}}
  </div>
</section>
