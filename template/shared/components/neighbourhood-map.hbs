<div class="neighbourhood-map-shell" aria-label="{{city_name}} neighbourhood map">
  <div
    class="neighbourhood-map real-neighbourhood-map"
    data-city-name="{{city_name}}"
    data-map-label="{{city_name}} neighbourhoods"
  >
    <div class="map-fallback">Loading real map...</div>
  </div>

  <div class="map-marker-data" hidden>
    {{#each neighbourhood_map}}
      <a
        href="{{url}}"
        data-lat="{{lat}}"
        data-lng="{{lng}}"
        data-label="{{label}}"
        data-tone="{{tone}}"
      >{{label}}</a>
    {{/each}}
  </div>

  <div class="map-caption">
    <span>Real map data</span>
    <span>Tap a district to open its guide</span>
  </div>
</div>
